# ═══════════════════════════════════════════════════════════════════════════
#  ERP COMERCIAL PERÚ · Plantilla de entorno (.env.example)
#  Copia este archivo como .env y completa los valores
# ═══════════════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5173
ERP_TENANT=AULA
DEMO_MODE=true

# ── Google Gemini API ─────────────────────────────────────────────────────
# Obtén tu API key gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Base de datos ─────────────────────────────────────────────────────────
# ERP_DB=data/erp.sqlite

# ── HTTPS / Red local (opcional) ─────────────────────────────────────────
# HOST=0.0.0.0
# TLS_CERT_FILE=certs/aula.pem
# TLS_KEY_FILE=certs/aula-key.pem
# APP_ORIGIN=https://192.168.1.20:5173

# ── Producción (DEMO_MODE=false) ─────────────────────────────────────────
# ADMIN_EMAIL=admin@tuempresa.com
# ADMIN_PASSWORD=
